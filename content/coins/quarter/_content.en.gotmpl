{{/* Content adapter: create one page per coin from data/quarters.json (Notion-synced).
     Language-aware: uses *_en fields on the English site, falling back to Korean. */}}
{{ $en := eq site.Language.Lang "en" }}
{{ range $c := site.Data.quarters }}
  {{ $title := $c.title_ko }}
  {{ $body := $c.body_ko }}
  {{ if $en }}
    {{ $title = or $c.title_en $c.name_en $c.title_ko }}
    {{ $body = or $c.body_en $c.body_ko }}
  {{ end }}
  {{ $page := dict
      "path" $c.slug
      "title" $title
      "params" (dict
          "coin" $c
          "seriesKo" $c.series_ko
          "coinYear" $c.year
          "showBreadcrumbs" true
          "showDate" false
          "showAuthor" false
          "showReadingTime" false
          "showTableOfContents" false
      )
      "content" (dict "mediaType" "text/markdown" "value" $body)
  }}
  {{ $.AddPage $page }}
{{ end }}
